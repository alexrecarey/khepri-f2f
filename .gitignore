!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sentry Config File
.env.sentry-build-plugin

# Army API downloads (scripts/fetch-army.mjs)
.cache/

# direnv (holds API keys)
.envrc

# Claude Code local worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# wrangler dev/deploy state
.wrangler/

# Rust build output (engine-rs/; the WASM it builds is committed in src/engine/wasm/)
engine-rs/target/
