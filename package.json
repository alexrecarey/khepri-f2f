{
  "name": "khepri-f2f",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:named": "portless",
    "build": "vite build",
    "check-build": "node scripts/check-build.mjs",
    "check-search-index": "node scripts/build-search-index.mjs && git diff --exit-code src/search/index.json",
    "preview": "vite preview",
    "fetch-army": "node --no-warnings scripts/fetch-army.mjs && node scripts/build-search-index.mjs",
    "test": "yarn test:js && yarn test:engine",
    "test:js": "node --test $(find src -name '*.test.mjs')",
    "test:engine": "uv run --python 3.12 --with icepool==2.2.2 --with pytest pytest -q src/engine",
    "build-search-index": "node scripts/build-search-index.mjs",
    "search-eval": "node scripts/search-eval.mjs"
  },
  "dependencies": {
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@vitejs/plugin-react": "^3.0.0",
    "portless": "0.15.7",
    "vite": "^4.0.0",
    "vite-plugin-pwa": "^0.14.4",
    "vite-plugin-svgr": "^2.4.0"
  },
  "volta": {
    "node": "24.21.0",
    "yarn": "3.3.0"
  },
  "portless": "khepri-f2f"
}
